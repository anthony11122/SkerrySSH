<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI installer UI localization (Simplified Chinese).
  jpackage generates the installer from a WiX main.wxs; this file is merged into the
  Product element (via jpackage resource-dir / compose resourceDir). The String entries
  override the WixUI_Minimal string table (copied from WiX's official zh-CN localization)
  so the install dialogs render in Chinese on any system language.
-->
<String Id="Next">下一步(&amp;N)</String>
<String Id="Back">上一步(&amp;B)</String>
<String Id="Cancel">取消</String>
<String Id="Install">安装(&amp;I)</String>
<String Id="Remove">卸载(&amp;R)</String>
<String Id="Repair">修复(&amp;R)</String>
<String Id="Browse">浏览(&amp;B)</String>
<String Id="OK">确定</String>
<String Id="Yes">是(&amp;Y)</String>
<String Id="No">否(&amp;N)</String>
<String Id="Finish">完成(&amp;F)</String>
<String Id="Ignore">忽略(&amp;I)</String>
<String Id="Retry">重试(&amp;R)</String>
<String Id="Abort">中止(&amp;A)</String>
<String Id="Close">关闭(&amp;C)</String>

<String Id="WelcomeDlgTitle">欢迎使用 [ProductName] 安装向导</String>
<String Id="WelcomeDlgDescription">安装向导将引导您完成 [ProductName] 的安装。\n\n单击“下一步”继续。</String>
<String Id="WelcomeDlgNext">下一步(&amp;N) &gt;</String>

<String Id="InstallDirDlgTitle">选择安装位置</String>
<String Id="InstallDirDlgDescription">单击“下一步”安装到此文件夹，或单击“更改”安装到其他文件夹。</String>
<String Id="InstallDirDlgFolder">文件夹(&amp;F):</String>

<String Id="VerifyReadyDlgTitle">准备安装</String>
<String Id="VerifyReadyDlgInstallTitle">准备安装 [ProductName]</String>
<String Id="VerifyReadyDlgRemoveTitle">准备卸载 [ProductName]</String>
<String Id="VerifyReadyDlgRepairTitle">准备修复 [ProductName]</String>
<String Id="VerifyReadyDlgDescription">单击“下一步”开始安装。</String>

<String Id="ProgressDlgTitle">正在安装 [ProductName]</String>
<String Id="ProgressDlgInstallTitle">正在安装 [ProductName]</String>
<String Id="ProgressDlgRemoveTitle">正在卸载 [ProductName]</String>
<String Id="ProgressDlgRepairTitle">正在修复 [ProductName]</String>

<String Id="ExitDialogDlgTitle">正在完成 [ProductName] 安装向导</String>
<String Id="ExitDialogDlgDescription">已成功安装 [ProductName]。单击“完成”退出向导。</String>

<String Id="ErrorDlgTitle">错误</String>
<String Id="ErrorDlgErrorTitle">[ProductName] 安装错误</String>
<String Id="ErrorDlgDescription1">[1]</String>
<String Id="ErrorDlgDescription2">请单击“重试”重新尝试安装，或单击“取消”退出安装。</String>

<String Id="UserExitDlgTitle">正在退出安装向导</String>
<String Id="UserExitDlgDescription">尚未安装 [ProductName]。您可以稍后再运行安装程序。单击“完成”退出向导。</String>

<String Id="FatalErrorDlgTitle">安装失败</String>
<String Id="FatalErrorDlgDescription1">[ProductName] 安装向导提前结束。</String>
<String Id="FatalErrorDlgDescription2">单击“完成”退出向导。</String>

<String Id="FilesInUseDlgTitle">文件正在使用</String>
<String Id="FilesInUseDlgDescription">以下应用程序正在使用需要更新的文件，请关闭这些应用程序，然后继续安装。</String>

<String Id="MaintenanceWelcomeDlgTitle">维护 [ProductName]</String>
<String Id="MaintenanceWelcomeDlgDescription">安装向导允许您修改 [ProductName] 的安装。\n\n单击“下一步”继续。</String>
<String Id="MaintenanceTypeDlgTitle">更改安装方式</String>
<String Id="MaintenanceTypeDlgDescription">选择要执行的操作。</String>

<String Id="PrepareDlgTitle">准备安装</String>
<String Id="PrepareDlgDescription">请稍候，安装向导正在准备安装。</String>
<String Id="PrepareDlgInstallTitle">正在准备安装 [ProductName]</String>
<String Id="PrepareDlgRemoveTitle">正在准备卸载 [ProductName]</String>
<String Id="PrepareDlgRepairTitle">正在准备修复 [ProductName]</String>

<String Id="BrowseDlgTitle">浏览文件夹</String>
<String Id="BrowseDlgDescription">选择一个文件夹。</String>

<String Id="MsiAccelerator">(&amp;)</String>
